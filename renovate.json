{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "customManagers": [
    {
      "customType": "regex",
      "description": "ruff, run by uvx in CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "ruff@(?<currentValue>[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "ruff"
    }
  ],
  "packageRules": [
    {
      "description": "A pin locks the version already in use, so there is no new release to wait out",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "container base images"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go modules"
    }
  ]
}
